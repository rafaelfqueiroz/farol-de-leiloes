{
  "name": "auctions-api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS service to import and serve Caixa auctions",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "24.22.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import ./dist/instrument.js dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --enable-source-maps --import ./dist/instrument.js dist/main.js)",
    "start:debug": "node --inspect=0.0.0.0:9229 --import ./dist/instrument.js dist/main.js",
    "migrate": "node dist/migrations/run.js",
    "test": "vitest run --project unit --project structural",
    "test:integration": "vitest run --project integration",
    "test:isolation": "vitest run --project isolation --passWithNoTests",
    "test:structural": "vitest run --project structural",
    "test:smoke": "npm run build && vitest run --project smoke",
    "test:cov": "vitest run --project unit --project structural --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix --pass-on-unpruned-suppressions",
    "lint:prune": "eslint . --prune-suppressions",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.991.0",
    "@aws-sdk/s3-request-presigner": "^3.991.0",
    "@date-fns/tz": "^1.5.0",
    "@nestjs/cache-manager": "^12.0.2",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.1.0",
    "@sentry/nestjs": "^11.10.0",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.8",
    "cheerio": "^1.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.0",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.3.1",
    "papaparse": "^5.5.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "puppeteer": "^25.16.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "stripe": "^20.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^12.3.2",
    "@testcontainers/mongodb": "^12.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supertest": "7.3.1",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "4.1.12"
  }
}
