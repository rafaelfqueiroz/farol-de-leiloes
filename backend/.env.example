MONGODB_URI=mongodb://localhost:27017/auctions
PORT=3000

# Auctions Import Job Configuration
IMPORT_ENABLED=true           # true/false - Global kill switch for import job
IMPORT_RUN_MODE=AUTO          # AUTO (scheduled at 3 AM) or MANUAL (runs on startup only)

# Email Configuration (SMTP)
SMTP_HOST=                    # e.g. smtp.gmail.com, smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false             # true for port 465, false for other ports
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@faroldosleiloes.com
