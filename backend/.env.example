# Backend environment (AR-44). Copy to .env and fill in; never commit the copy (SC-16).
# Validated at boot by src/config/env.schema.ts (AR-41): every secret and integration value is
# required in every environment, and an empty value counts as unset. Each variable has the comment
# line directly above it; test/structural/env-example.spec.ts keeps this file and the schema equal.

# --- Server ---

# development | test | production. Defaults to development.
NODE_ENV=development
# Port the API listens on. Defaults to 3000.
PORT=3000
# Web app origin: CORS, OAuth and checkout redirects, links in emails.
FRONTEND_URL=http://localhost:3001
# MongoDB connection string.
MONGODB_URI=mongodb://localhost:27017/auctions

# --- Auth ---

# Secret that signs the session JWTs. A long random string; never reuse another environment's.
JWT_SECRET=replace-with-a-long-random-string
# Google OAuth client id (Google Cloud console, OAuth 2.0 credentials).
GOOGLE_CLIENT_ID=your-google-client-id
# Google OAuth client secret.
GOOGLE_CLIENT_SECRET=your-google-client-secret
# OAuth callback URL registered with Google; points at this API.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Payments (Stripe) ---

# Stripe secret key (use a sk_test_ key outside production).
STRIPE_SECRET_KEY=sk_test_replace-me
# Signing secret of the Stripe webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_replace-me
# Stripe price id of the Standard plan (price_...).
STRIPE_STANDARD_PRICE_ID=price_replace-me

# --- Email (SMTP) ---

# Sender address of every email the app sends.
EMAIL_FROM=noreply@faroldosleiloes.com
# SMTP server host, e.g. smtp.sendgrid.net.
SMTP_HOST=smtp.example.com
# SMTP port. Defaults to 587.
SMTP_PORT=587
# true for implicit TLS (port 465), false for STARTTLS (587). Defaults to false.
SMTP_SECURE=false
# SMTP user name.
SMTP_USER=your-smtp-user
# SMTP password.
SMTP_PASS=your-smtp-password

# --- Notifications ---

# API key of the SMS provider used for reminders.
SMS_PROVIDER_API_KEY=your-sms-provider-key
# API key of the WhatsApp provider used for reminders.
WHATSAPP_API_KEY=your-whatsapp-provider-key

# --- AI search (LLM) ---

# ollama | groq | gemini | openai | anthropic. Defaults to ollama. Only the selected provider's
# API key is required.
LLM_PROVIDER=ollama
# Ollama model. Defaults to qwen2.5:3b.
OLLAMA_MODEL=qwen2.5:3b
# Ollama OpenAI-compatible endpoint. Defaults to http://localhost:11434/v1.
OLLAMA_BASE_URL=http://localhost:11434/v1
# Groq model. Defaults to llama-3.1-8b-instant.
GROQ_MODEL=llama-3.1-8b-instant
# Groq API key; required when LLM_PROVIDER=groq.
GROQ_API_KEY=fake-GROQ_API_KEY
# Gemini model. Defaults to gemini-2.0-flash.
GEMINI_MODEL=gemini-2.0-flash
# Google AI (Gemini) API key; required when LLM_PROVIDER=gemini.
GOOGLE_API_KEY=fake-GOOGLE_API_KEY
# OpenAI model. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
# OpenAI API key; required when LLM_PROVIDER=openai.
OPENAI_API_KEY=fake-OPENAI_API_KEY
# Anthropic model. Defaults to claude-sonnet-4-20250514.
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Anthropic API key; required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=fake-ANTHROPIC_API_KEY

# --- File storage (Cloudflare R2) ---

# Cloudflare account id that owns the R2 bucket.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# R2 access key id.
R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2 secret access key.
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2 bucket name.
R2_BUCKET=farol-leiloes
# Public base URL the bucket's files are served from.
R2_PUBLIC_URL=https://files.example.com

# --- Scheduled jobs ---

# Kill switch of the daily Caixa CSV import. Defaults to true.
IMPORT_ENABLED=true
# Run the import once at boot. Defaults to false.
IMPORT_ON_START_UP=false
# Kill switch of the auction details scraper. Defaults to true.
SCRAPER_ENABLED=true
# Run the scraper once at boot. Defaults to false.
SCRAPER_ON_START_UP=false
# Kill switch of the reminder sender. Defaults to true.
REMINDERS_ENABLED=true
# Run the expired-auction cleanup once at boot. Defaults to false.
CLEANUP_ON_STARTUP=false
# Cache the neighbourhood lists in memory. Defaults to false.
NEIGHBORHOODS_CACHE_ENABLED=false
# Neighbourhood cache TTL in milliseconds. Defaults to 600000 (10 minutes).
NEIGHBORHOODS_CACHE_TTL=600000
