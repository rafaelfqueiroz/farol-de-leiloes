# Backend environment (AR-44). Copy to .env and fill in; never commit the copy (SC-16).
# Validated at boot by src/config/env.schema.ts (AR-41): every secret and integration value is
# required in every environment, and an empty value counts as unset. Each variable has the comment
# line directly above it; test/structural/env-example.spec.ts keeps this file and the schema equal.

# --- Server ---

# development | test | production. Defaults to development.
NODE_ENV=development
# Port the API listens on. Defaults to 3000.
PORT=3000
# Web app origin: CORS, OAuth and checkout redirects, links in emails.
FRONTEND_URL=http://localhost:3001
# Reverse-proxy hops in front of the API (SC-04): 1 behind Caddy in production, so the client
# address comes from X-Forwarded-For. Defaults to 0, for a process reached directly.
TRUST_PROXY_HOPS=0
# MongoDB connection string.
MONGODB_URI=mongodb://localhost:27017/auctions

# --- Auth ---

# Secret that signs the session JWTs. A long random string; never reuse another environment's.
JWT_SECRET=replace-with-a-long-random-string
# Google OAuth client id (Google Cloud console, OAuth 2.0 credentials).
GOOGLE_CLIENT_ID=your-google-client-id
# Google OAuth client secret.
GOOGLE_CLIENT_SECRET=your-google-client-secret
# OAuth callback URL registered with Google; points at this API.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Payments (Stripe) ---

# Stripe secret key (use a sk_test_ key outside production).
STRIPE_SECRET_KEY=sk_test_replace-me
# Signing secret of the Stripe webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_replace-me
# Stripe Billing Portal configuration id (bpc_...), restricted to the payment method and invoices
# (SPEC-012 BR-012-17, BR-012-19, BR-012-29). Optional for the deploy, REQUIRED before the portal
# works in production: with NODE_ENV=production and no id the billing portal route is refused
# (BILLING_PORTAL_FAILED), because Stripe's default portal could offer cancellation and plan changes
# outside our rules. Outside production the default configuration is used.
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=

# --- Email (SMTP) ---

# Sender address of every email the app sends.
EMAIL_FROM=noreply@faroldosleiloes.com
# SMTP server host, e.g. smtp.sendgrid.net.
SMTP_HOST=smtp.example.com
# SMTP port. Defaults to 587.
SMTP_PORT=587
# true for implicit TLS (port 465), false for STARTTLS (587). Defaults to false.
SMTP_SECURE=false
# SMTP user name.
SMTP_USER=your-smtp-user
# SMTP password.
SMTP_PASS=your-smtp-password

# --- Notifications ---

# API key of the SMS provider used for reminders.
SMS_PROVIDER_API_KEY=your-sms-provider-key
# API key of the WhatsApp provider used for reminders.
WHATSAPP_API_KEY=your-whatsapp-provider-key

# --- AI search (LLM) ---

# ollama | groq | gemini | openai | anthropic. Defaults to ollama. Only the selected provider's
# API key is required.
LLM_PROVIDER=ollama
# Ollama model. Defaults to qwen2.5:3b.
OLLAMA_MODEL=qwen2.5:3b
# Ollama OpenAI-compatible endpoint. Defaults to http://localhost:11434/v1.
OLLAMA_BASE_URL=http://localhost:11434/v1
# Groq model. Defaults to llama-3.1-8b-instant.
GROQ_MODEL=llama-3.1-8b-instant
# Groq API key; required when LLM_PROVIDER=groq.
GROQ_API_KEY=fake-GROQ_API_KEY
# Gemini model. Defaults to gemini-2.0-flash.
GEMINI_MODEL=gemini-2.0-flash
# Google AI (Gemini) API key; required when LLM_PROVIDER=gemini.
GOOGLE_API_KEY=fake-GOOGLE_API_KEY
# OpenAI model. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
# OpenAI API key; required when LLM_PROVIDER=openai.
OPENAI_API_KEY=fake-OPENAI_API_KEY
# Anthropic model. Defaults to claude-sonnet-4-20250514.
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Anthropic API key; required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=fake-ANTHROPIC_API_KEY

# --- File storage (Cloudflare R2) ---

# Cloudflare account id that owns the R2 bucket.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# R2 access key id.
R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2 secret access key.
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2 bucket name.
R2_BUCKET=farol-leiloes
# Public base URL the bucket's files are served from.
R2_PUBLIC_URL=https://files.example.com
# Bucket of client files (SPEC-017, SC-18): NO public access, and never the same as R2_BUCKET, which
# R2_PUBLIC_URL serves openly (the API refuses to boot otherwise). Optional until SPEC-017; when
# unset, client file links are refused. Create it before SPEC-017 ships (owner action).
R2_PRIVATE_BUCKET=farol-leiloes-private

# --- Caixa access (SPEC-004, SC-24, ADR-003) ---
# Every request to venda-imoveis.caixa.gov.br goes through one port (CaixaAccess); these settings
# are read by its HTTP adapter. Requests carry the honest user agent FarolDosLeiloes/1.0.

# Optional proxy Caixa traffic leaves through, an http:// or https:// URL (it may carry credentials,
# so treat it as a secret). Unset means a direct connection. SOCKS is refused at boot: reaching a
# SOCKS endpoint needs a bridge, which ADR-003 / #108 decides. Never add or change it because Caixa
# blocked a request (SC-24); it is set only once ADR-003 is accepted.
CAIXA_PROXY_URL=
# Milliseconds one Caixa request may take, connection to last byte. Positive integer, at most
# 120000 (2 minutes). Defaults to 30000.
CAIXA_REQUEST_TIMEOUT_MS=30000
# Bytes a Caixa response may carry; a larger body is refused. Positive integer, at most 104857600
# (100 MiB). Defaults to 20971520 (20 MiB); the list is about 8 MB.
CAIXA_MAX_DOWNLOAD_BYTES=20971520

# --- Scheduled jobs ---

# Kill switch of the daily Caixa CSV import. Defaults to true.
IMPORT_ENABLED=true
# Run the import once at boot. Defaults to false.
IMPORT_ON_START_UP=false
# Kill switch of the detail-page collection (SPEC-004 BR-004-18), which runs inside the daily import
# after the list is applied. Off, nothing is collected and the daily update still completes.
# Defaults to true. It has no start-up switch of its own: IMPORT_ON_START_UP runs the whole day.
SCRAPER_ENABLED=true
# Kill switch of the reminder sender. Defaults to true.
REMINDERS_ENABLED=true
# Kill switch of the daily subscription reconcile job, which re-reads subscriptions from Stripe to
# heal lost webhook events (SPEC-012, ADR-005). Defaults to true.
SUBSCRIPTIONS_RECONCILE_ENABLED=true
# Kill switch of the daily job that deletes the personal data of closed accounts (SPEC-010
# BR-010-15). Defaults to true; leave it on in production, the 30-day legal limit depends on it.
ACCOUNT_PURGE_ENABLED=true
# Kill switch of the worker that builds the data exports requested by account holders (SPEC-010
# BR-010-11); with it off a request waits, queued. Defaults to true.
DATA_EXPORT_ENABLED=true
# Kill switch of the daily job that deletes the documents of journeys closed more than
# DOCUMENT_RETENTION_YEARS ago (SPEC-010 BR-010-21). It deletes through the closed-journey files
# source SPEC-017 binds and finds nothing until then. Defaults to true.
DOCUMENT_RETENTION_ENABLED=true
# Run the expired-auction cleanup once at boot. Defaults to false.
CLEANUP_ON_STARTUP=false
# Cache the neighbourhood lists in memory. Defaults to false.
NEIGHBORHOODS_CACHE_ENABLED=false
# Neighbourhood cache TTL in milliseconds. Defaults to 600000 (10 minutes).
NEIGHBORHOODS_CACHE_TTL=600000

# --- Business settings (AR-43) ---

# Saved filters one user may keep; the next one is refused with SAVED_FILTER_LIMIT_REACHED
# (SPEC-007, plan limit open in Q-15). Positive integer. Defaults to 10.
SAVED_FILTERS_MAX_PER_USER=10
# Days an unavailable auction is kept before the cleanup job removes it and its stored files.
# Positive integer. Defaults to 14.
UNAVAILABLE_AUCTION_RETENTION_DAYS=14
# Days an office whose subscription lapsed keeps working before it turns read-only until it pays
# again (SPEC-012 BR-012-28, D-47). Positive integer. Defaults to 10.
SUBSCRIPTION_GRACE_DAYS=10
# Days after the first payment's confirmation in which cancelling the first subscription refunds it
# in full (SPEC-012 BR-012-29, D-48, CDC art. 49; pending the lawyer, Q-21). Positive integer.
# Defaults to 7.
REFUND_WINDOW_DAYS=7
# Least share of the last applied Caixa list's rows a new list must hold; a smaller one is rejected
# as truncated and nothing from it is applied (SPEC-004 BR-004-04). A ratio above 0 and at most 1.
# Defaults to 0.8 (80%).
IMPORT_MIN_ROW_RATIO=0.8
# National holidays, comma-separated YYYY-MM-DD days in Brasília (SPEC-004 BR-004-31): on one of
# them, or on a weekend, a day with no new Caixa list is "no update", not a failure. Edit it each
# year (see docs/runbooks/caixa-import.md); a year with no entry logs a warning and only weekends
# count. An invalid entry stops the boot. Defaults to empty.
NATIONAL_HOLIDAYS=
# The daily import's window opens at this Brasília time, HH:mm (SPEC-004 BR-004-01): no attempt
# before it. Default 06:00.
IMPORT_WINDOW_START=06:00
# The cutoff, Brasília HH:mm, later than the start (SPEC-004 BR-004-03): no attempt from it on, and
# the day is decided (new list applied, no new list, or no update). Default 12:00.
IMPORT_CUTOFF=12:00
# Attempts a day at most (SPEC-004 BR-004-02). Integer from 1 to 48. Default 12.
IMPORT_MAX_ATTEMPTS=12
# Minutes between two attempts (SPEC-004 BR-004-02). Integer of at least 5, the tick. Default 30.
IMPORT_ATTEMPT_SPACING_MINUTES=30
# Detail pages collected a Brasília day, at most (SPEC-004 BR-004-18), counted across the day's
# passes. New and returned properties go first. Size it from docs/runbooks/caixa-import.md: it must
# be at least the active catalogue divided by ENRICHMENT_MAX_STALENESS_DAYS. Positive integer, at
# most 100000. Default 300.
ENRICHMENT_DAILY_PAGES=300
# Requests to Caixa of every kind a Brasília day, at most: detail pages AND photos AND documents
# (SPEC-004 BR-004-18, SC-24). Counted across the day's passes. Positive integer, at most 1000000.
# Default 2000.
ENRICHMENT_DAILY_REQUESTS=2000
# Requests to Caixa in flight at once (BR-004-18, SC-24). Integer from 1 to 4. Default 1.
ENRICHMENT_CONCURRENCY=1
# Milliseconds between the starts of two requests to Caixa, whichever worker makes them (BR-004-18,
# SC-24). A fixed interval, never randomised. Integer of at least 1000. Default 5000.
ENRICHMENT_MIN_PAUSE_MS=5000
# Days between two collections of an active property, at most (BR-004-19). Default 7.
ENRICHMENT_MAX_STALENESS_DAYS=7
# Days a property whose page failed is left alone (BR-004-21); it doubles with each consecutive
# failure up to 16 days (or this value if larger). Default 1.
ENRICHMENT_FAILURE_BACKOFF_DAYS=1
# Failures in a row that stop the day's pass (a timeout, an unreachable or unreadable page; not a
# block). Default 5.
ENRICHMENT_MAX_CONSECUTIVE_FAILURES=5
# Photos copied per property (BR-004-22). Integer from 1 to 30. Default 12.
ENRICHMENT_MAX_PHOTOS=12
# Bytes above which a photo is refused instead of copied. At most 20971520 (20 MiB). Default 5242880.
ENRICHMENT_MAX_PHOTO_BYTES=5242880
# Bytes above which a matrícula or an edital is refused instead of copied. At most 104857600
# (100 MiB); CAIXA_MAX_DOWNLOAD_BYTES also bounds what the adapter reads. Default 20971520.
ENRICHMENT_MAX_DOCUMENT_BYTES=20971520

# --- Privacy (SPEC-010) ---

# Whether an account that has not accepted the current terms of use and privacy policy is refused
# the account features with 403 TERMS_ACCEPTANCE_REQUIRED (BR-010-05). Acceptances are recorded
# either way. Defaults to false until the screen that asks for the acceptance ships; the frontend
# change that adds it flips the default to true.
TERMS_ENFORCEMENT_ENABLED=false
# The legal ceiling, in days, between the closure of an account and the deletion of its personal data
# (SPEC-010 BR-010-15, RNF-24). Positive integer. Defaults to 30.
ACCOUNT_PURGE_MAX_DAYS=30
# An error is logged when a closed account is still not purged this many days after its closure
# (BR-010-15). Positive integer, at most ACCOUNT_PURGE_MAX_DAYS. Defaults to 25.
ACCOUNT_PURGE_ALERT_DAYS=25
# Days an export stays downloadable after it became ready, then it is deleted (SPEC-010 BR-010-11).
# Needs R2_PRIVATE_BUCKET: without it every export fails with a stable code instead of being built.
# Positive integer. Defaults to 7.
EXPORT_TTL_DAYS=7
# Whole years the documents of a closed journey are kept after its closing date in Brasília, then
# deleted for good (SPEC-010 BR-010-18, BR-010-19, RNF-24, D-38). Provisional until the lawyer's
# validation of the retention periods is recorded (BR-010-24, BR-010-26, Q-21); the launch checklist
# shows it. Positive integer. Defaults to 5.
# WARNING: LOWERING it deletes irreversibly at the next 04:30 run (the journeys between the old and the
# new date become due). Confirm the new value against the lawyer's opinion first; RAISING it is safe.
# While the period is provisional or lower than the validated one, a run deletes at most 25 journeys.
DOCUMENT_RETENTION_YEARS=5
# Whether routes marked @RequiresLegalValidation (legal-analysis features, SPEC-015 and SPEC-024)
# answer 403 LEGAL_VALIDATION_REQUIRED until a lawyer's validation is recorded with `npm run
# legal:record-validation` (SPEC-010 BR-010-25). true or false. Left empty it is true when NODE_ENV is
# production and false otherwise; set it to true in a staging environment to see the gate as
# production will.
LEGAL_GATE_ENFORCED=

# --- Observability (ARCHITECTURE §11) ---

# fatal | error | warn | info | debug | trace | silent. Defaults to info. Logs are JSON on stdout.
LOG_LEVEL=info
# HMAC-SHA256 key of the hashed user id in log lines (AR-46), at least 32 characters. Required in
# production; when unset elsewhere, log lines carry no user id at all.
LOG_HASH_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Sentry DSN of the backend project (AR-47). Unset keeps Sentry inert; production logs a warning
# at boot when it is missing. Read from the process environment by src/instrument.ts before the
# app loads .env, so a value only in .env is validated but does not switch Sentry on.
SENTRY_DSN=
