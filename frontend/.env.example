# Frontend configuration. Copy to .env.local and adjust. Read only through lib/env.ts (AR-42);
# every variable lib/env.ts reads is listed here (AR-44). Nothing below is a secret.

# Public: where the browser reaches the backend (Google sign-in redirect, neighborhoods lookup).
# Shipped in the JS bundle, inlined at build time. No trailing slash, no /api.
NEXT_PUBLIC_AUCTIONS_API_URL=http://localhost:3000

# Public: canonical origin of this site, used for page metadata, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://faroldosleiloes.com.br

# Public: Sentry DSN for error tracking (AR-47). A DSN is public by design (SC-16). Optional: leave
# empty and Sentry is inert. Events are scrubbed of bodies, headers, cookies, queries and users.
NEXT_PUBLIC_SENTRY_DSN=

# Server-only: where the Next.js server reaches the backend (API routes, SSR, sitemap). Replaces the
# former AUCTIONS_API_URL. If unset, NEXT_PUBLIC_AUCTIONS_API_URL is used; set it when the server
# reaches the backend on a private address (e.g. http://backend:3000 in Docker Compose).
BACKEND_API_URL=http://localhost:3000
